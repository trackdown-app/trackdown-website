# Copy to `.env.local` (ignored by Git). See docs/deploy.md#the-game-data.

# The `data/` folder of a local trackdown-data checkout, relative to this
# repository or absolute. Without it the site builds and runs without data.
TRACKDOWN_DATA_DIR=../TrackdownData/data

# The client keys the REST API under /api/v1 accepts, comma-separated, read
# at runtime. Send one as `Trackdown-Client-Key`, with `Trackdown-App-Version`,
# to call it locally. See docs/api.md#client-identification.
TRACKDOWN_CLIENT_KEYS=local-dev-key

# Server logs and traces to PostHog EU. Optional locally (console only when
# empty); required on Vercel. Never use a VITE_ prefix. See docs/logging.md.
POSTHOG_PROJECT_TOKEN=
