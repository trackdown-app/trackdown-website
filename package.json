{
  "name": "trackdown-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "test": "bun run paraglide:compile && vitest run",
    "lint": "bun run paraglide:compile && eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "bun run paraglide:compile && node_modules/typescript-7/bin/tsc --noEmit",
    "paraglide:compile": "bun run scripts/compile-paraglide.ts",
    "data:check": "bun run scripts/check-data.ts",
    "build:guard": "bun run scripts/check-build-output.ts",
    "openapi": "bun run paraglide:compile && bun run scripts/openapi.ts",
    "openapi:check": "bun run paraglide:compile && bun run scripts/openapi.ts --check",
    "postinstall": "bun run paraglide:compile --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.71.0",
    "vercel": "^65.11.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
