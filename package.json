{
  "name": "trackdown-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "test": "bun run paraglide:compile && vitest run",
    "lint": "bun run paraglide:compile && eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "bun run paraglide:compile && node_modules/typescript-7/bin/tsc --noEmit",
    "paraglide:compile": "bun run scripts/compile-paraglide.ts",
    "data:check": "bun run scripts/check-data.ts",
    "build:guard": "bun run scripts/check-build-output.ts",
    "test:browser": "playwright test",
    "lighthouse": "lhci autorun",
    "openapi": "bun run paraglide:compile && bun run scripts/openapi.ts",
    "openapi:check": "bun run paraglide:compile && bun run scripts/openapi.ts --check",
    "postinstall": "bun run paraglide:compile --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.3",
    "cbor": "^10.0.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "nitro": "^3.0.261103-rc",
    "node-app-attest": "^1.0.1",
    "posthog-js": "^1.447.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unstorage": "^2.0.0-alpha.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.72.2",
    "vercel": "^65.12.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
